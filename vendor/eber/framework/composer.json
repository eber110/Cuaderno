{
    "name": "eber/framework",
    "description": "Mi increíble framework",
    "authors": [
        {
            "name": "Eber Sánchez Cornejo",
            "email": "contacto@ebersanchez.cl"
        }
    ],
    "require": {
        "matthiasmullie/minify": "^1.3",
        "phpmailer/phpmailer": "^6.10",
        "vlucas/phpdotenv": "^5.6",
        "phenx/php-font-lib": "*",
        "geoip2/geoip2": "*"
    },
    "autoload": {
        "psr-4": {
            "Core\\": "Core/",
            "Core\\ConfigLoader\\": "Core/ConfigLoader/",
            "Base\\": "Base/"
        },
        "files": [
            "Base/Helpers/Svg.php",
            "Base/Helpers/Part.php",
            "Base/Helpers/Number.php",
            "Base/Helpers/Lang.php",
            "Base/Cookie/CookieConfiguration.php"
        ]
    },
    "scripts": {
        "frame": "php Base/ScriptComposer/FrameCli.php",
        "new-project": "php Base/ScriptComposer/NewProject.php",
        "package": "php Base/ScriptComposer/DeployPackage.php package",
        "deploy": "php Base/ScriptComposer/DeployPackage.php deploy",
        "init-app": "php Base/ScriptComposer/InitAppStructure.php",
        "link": "php Base/ScriptComposer/LinkProject.php",
        "theme:build": "php Base/ScriptComposer/BuildTheme.php",
        "theme:studio": "php Base/ScriptComposer/OpenStudio.php",
        "min-script": "php Base/ScriptComposer/MinJsCss.php",
        "create-table-mysql": "php Base/ScriptComposer/ConfigInitBdMySql.php",
        "create-table-pgsql": "php Base/ScriptComposer/ConfigInitBdPostgreSql.php",
        "install-font": "php Base/ScriptComposer/InstallFont.php",
        "reset-font": "php Base/ScriptComposer/ResetFont.php",
        "update-geoip": "php Base/ScriptComposer/UpdateGeoIp.php",
        "scan-routes": "php Base/ScriptComposer/ScanRoutes.php",
        "key:rotate": "php Base/ScriptComposer/RotateKeys.php",
        "convert-image": "php Base/ScriptComposer/ConvertImage.php",
        "make:controller": "php Base/ScriptComposer/MakeCli.php controller",
        "make:model": "php Base/ScriptComposer/MakeCli.php model",
        "make:component": "php Base/ScriptComposer/MakeCli.php component",
        "make:middleware": "php Base/ScriptComposer/MakeCli.php middleware",
        "lang:make": "php Base/ScriptComposer/LangCli.php make",
        "lang:check": "php Base/ScriptComposer/LangCli.php check",
        "lang:scan": "php Base/ScriptComposer/LangCli.php scan",
        "lang:export": "php Base/ScriptComposer/LangCli.php export",
        "lang:import": "php Base/ScriptComposer/LangCli.php import"
    }
}

# ==================== APPLICATION ====================
# Semilla de cálculo de tokens y firma JWT (clave secreta aleatoria)
SEED=""

# Nombre de la aplicación/sitio web
APP_NAME="Mi Sitio"

# Entorno de la aplicación (development / production)
APP_ENV="development"

# Descripción general del sitio para metatags y SEO
APP_DESCRIPTION=""

# Forzar dominio en producción (ej: www.mi-sitio.com o mi-sitio.com)
FORCE_DOMAIN=""

# Tema inicial por defecto (system: opción del navegador, dark: oscuro, light: claro)
DEFAULT_THEME="system"


# ==================== DATABASE ====================
# Tipo de conexión de base de datos (mysql / pgsql / sqlite)
DB_CONNECTION="mysql"

# Servidor de base de datos (ej: localhost o 127.0.0.1)
DB_HOST="127.0.0.1"

# Puerto de la base de datos (mysql: 3306, pgsql: 5432)
DB_PORT="3306"

# Nombre de la base de datos (o ruta del archivo si es sqlite, ej: Database/app.sqlite)
DB_DATABASE=""

# Usuario de la base de datos
DB_USERNAME="root"

# Contraseña de la base de datos
DB_PASSWORD=""

# Codificación de caracteres de la base de datos
DB_CHARSET="utf8mb4"

# Utilizar pooling / reutilización de conexión PDO Singleton (true / false)
DB_POOLING="true"


# ==================== SECURITY & CACHE ====================
# Activar protección contra ataques CSRF en formularios (true / false)
CSRF_PROTECTION="true"

# Activar caché global del sistema (true / false)
USE_CACHE="true"


# ==================== SMTP (CORREO) ====================
# Servidor de correo de salida SMTP (ej: mail.mi-sitio.com)
SMTP_HOST=""

# Usuario SMTP / Correo electrónico remitente
SMTP_USER=""

# Contraseña SMTP
SMTP_PASS=""

# Puerto del servidor SMTP (común: 587, 465, 25)
SMTP_PORT="587"


# ==================== IMAGES ====================
# Directorio absoluto o relativo donde se guardan las imágenes subidas
DIR_UPLOAD_MEDIA=""

# Directorio donde se guardan los GIFs subidos (opcional, por defecto /Uploads/)
DIR_UPLOAD_GIF=""

# URL o ruta pública para mostrar las imágenes en la web (opcional, por defecto /Uploads/)
DIR_SHOW_MEDIA=""

# Activar compresión automática de imágenes subidas (true / false)
COMPRESS_IMAGE="true"

# Formato de compresión por defecto (webp / avif / png / jpg)
IMAGE_FORMAT="webp"

# Ancho máximo permitido para redimensionar imágenes (ej: 1920)
MAX_IMAGE_WIDTH="1920"

# Alto máximo permitido para redimensionar imágenes (ej: 1080)
MAX_IMAGE_HEIGHT="1080"

# Activar compresión inteligente reduciendo peso según dimensiones (true / false)
SMART_COMPRESSION="true"

# Peso máximo en KB para las imágenes procesadas (0 para ilimitado, o ej: 500)
MAX_IMAGE_KB="0"

# Calidad mínima aceptada durante la compresión iterativa (ej: 20)
MIN_QUALITY="20"

# Pasos de reducción de calidad en cada iteración de compresión (ej: 5)
QUALITY_STEP="5"

# Carga diferida (lazy load) de imágenes para acelerar velocidad inicial (true / false)
LAZY_LOAD_IMAGES="true"


# ==================== GEOLOCATION ====================
# Endpoint API primaria para geolocalización por IP
GEO_API_PRIMARY="https://ip.guide/"

# Endpoint API de respaldo (fallback) para geolocalización por IP
GEO_API_FALLBACK="https://api.ipquery.io/"

# Tiempo máximo de espera en segundos para conectar a la API (ej: 3)
GEO_CONNECT_TIMEOUT="3"

# Tiempo máximo de espera para completar la solicitud en segundos (ej: 5)
GEO_REQUEST_TIMEOUT="5"

# License Key para descargar actualizaciones de MaxMind GeoLite2
MAXMIND_LICENSE_KEY=""


# ==================== SEO ====================
# Idioma regional para Open Graph / Metatags (ej: es, es_CL, en)
OG_LOCALE="es"

# Subdominios o hosts separados por coma excluidos de la indexación (ej: admin.mi-sitio.com)
NO_INDEX_HOSTS=""

# Datos Estructurados JSON-LD de Persona (opcional)
SEO_PERSON_NAME=""
SEO_PERSON_URL=""
SEO_PERSON_JOB=""
SEO_PERSON_KNOWS=""


# ==================== EXTERNAL APIs ====================
# Clave de API para integraciones con Google Gemini AI
GEMINI_API_KEY=""

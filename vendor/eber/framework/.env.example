# ==================== APPLICATION ====================
# Semilla de calculo de tokens (clave, numero aleatorio, etc.)
SEED=""

# Nombre de la aplicación/sitio web
APP_NAME=""

# Entorno de la aplicación (DEV / PRODUCTION)
APP_ENV=""

# Descripción general del sitio para metatags y SEO
APP_DESCRIPTION=""

# Forzar dominio en producción (ej: www.mi-sitio.com o mi-sitio.com)
FORCE_DOMAIN=""

# Tema inicial por defecto (system: opción del navegador, dark: oscuro, light: claro)
DEFAULT_THEME=""


# ==================== DATABASE ====================
# Tipo de conexión de base de datos (mysql / pgsql)
DB_CONNECTION=""

# Servidor de base de datos (ej: localhost o 127.0.0.1)
DB_HOST=""

# Puerto de la base de datos (mysql: 3306, pgsql: 5432)
DB_PORT=""

# Nombre de la base de datos
DB_DATABASE=""

# Usuario de la base de datos
DB_USERNAME=""

# Contraseña de la base de datos
DB_PASSWORD=""

# Codificación de caracteres de la base de datos
DB_CHARSET=""


# ==================== SMTP ====================
# Servidor de correo de salida SMTP (ej: mail.mi-sitio.com)
SMTP_HOST=""

# Usuario SMTP / Correo electrónico remitente
SMTP_USER=""

# Contraseña SMTP
SMTP_PASS=""

# Puerto del servidor SMTP (común: 587, 465, 25)
SMTP_PORT=""


# ==================== FEATURES ====================
# Activar o desactivar el módulo de inicio de sesión (true / false)
LOGIN_ACTIVE=""

# Guardar registro de acciones de usuarios logueados (true / false)
LOG_USER=""

# Guardar registro de visitas en Logs/VisitLog (true / false)
LOG_VISITOR=""

# Incrementar y contar visitas totales en base de datos (true / false)
COUNT_VISIT=""


# ==================== DEVELOPMENT ====================
# Dirección IP autorizada para depuración o modo desarrollo bypass
DEV_IP=""


# ==================== SECURITY ====================
# Activar protección contra ataques CSRF en formularios (true / false)
CSRF_PROTECTION=""

# Utilizar pooling de conexiones a base de datos si está soportado (true / false)
DB_POOLING=""

# Activar caché global del sistema (true / false)
USE_CACHE=""


# ==================== IMAGES ====================
# Directorio absoluto donde se guardan las imágenes subidas (ej: C:/xampp/htdocs/misitio/App/Public/Img/)
DIR_UPLOAD_MEDIA=""

# Directorio absoluto donde se guardan los GIFs subidos (ej: C:/xampp/htdocs/misitio/App/Public/Img/)
DIR_UPLOAD_GIF=""

# Ruta pública para mostrar las imágenes en la web (ej: http://localhost/misitio/App/Public/Img/)
DIR_SHOW_MEDIA=""

# Ruta pública para mostrar las imágenes estáticas de la aplicación (por defecto: /App/Public/Img/)
DIR_IMG_SHOW_STATIC=""

# Activar compresión automática de imágenes subidas (true / false)
COMPRESS_IMAGE=""

# Formato de compresión por defecto (webp / avif / png / jpg)
IMAGE_FORMAT=""

# Ancho máximo permitido para redimensionar imágenes (ej: 1920)
MAX_IMAGE_WIDTH=""

# Alto máximo permitido para redimensionar imágenes (ej: 1080)
MAX_IMAGE_HEIGHT=""

# Activar compresión inteligente reduciendo peso sin pérdida de calidad (true / false)
SMART_COMPRESSION=""

# Peso máximo en KB para las imágenes procesadas (0 para ilimitado, o ej: 500 para máximo 500KB)
MAX_IMAGE_KB=""

# Calidad mínima aceptada durante la compresión iterativa (ej: 20)
MIN_QUALITY=""

# Pasos de reducción de calidad en cada iteración de compresión (ej: 5)
QUALITY_STEP=""


# ==================== OPTIMIZATION ====================
# Activar Lazy Loading dinámico de scripts y assets (true / false)
LAZY_LOADING=""

# Limpieza automática de recursos temporales o no utilizados (true / false)
CLEANUP_RESOURCES=""

# Usar almacenamiento en archivos para caché (true / false)
FILE_CACHE=""

# Usar caché en memoria (Redis/OPcache/etc) si está disponible (true / false)
MEMORY_CACHE=""

# Almacenar en caché consultas repetitivas de base de datos (true / false)
DB_CACHE=""

# Minificar automáticamente archivos CSS y JS compilados (true / false)
MINIFY_ASSETS=""

# Utilizar CDN externo para cargar librerías estáticas (true / false)
USE_CDN=""

# Optimización y precarga inteligente de fuentes tipográficas en <head> (true / false)
OPTIMIZE_FONTS=""

# Carga diferida (lazy load) de imágenes para acelerar velocidad inicial (true / false)
LAZY_LOAD_IMAGES=""

# Utilizar índices optimizados en consultas y base de datos (true / false)
USE_INDEXES=""


# ==================== SOCIAL MEDIA ====================
# Enlaces de redes sociales de la aplicación
SOCIAL_GITHUB=""
SOCIAL_TWITTER=""
SOCIAL_INSTAGRAM=""
SOCIAL_LINKEDIN=""


# ==================== GEOLOCATION ====================
# Endpoint API primaria para geolocalización por IP
GEO_API_PRIMARY=""

# Endpoint API de respaldo (fallback) para geolocalización por IP
GEO_API_FALLBACK=""

# Tiempo máximo de espera en segundos para conectar a la API (ej: 3)
GEO_CONNECT_TIMEOUT=""

# Tiempo máximo de espera para completar la solicitud en segundos (ej: 5)
GEO_REQUEST_TIMEOUT=""


# ==================== SEO ====================
# Idioma regional para Open Graph / Metatags (ej: es, en)
OG_LOCALE=""

# Subdominios o hosts separados por coma excluidos de la indexación (ej: eberstudio.cl)
NO_INDEX_HOSTS=""

# Nombre completo de la persona/autor del portafolio (para Datos Estructurados JSON-LD)
SEO_PERSON_NAME=""

# URL principal del perfil (dejar vacío para auto-detectar el dominio actual)
SEO_PERSON_URL=""

# Profesión/Cargo principal de la persona (ej: Desarrollador Web Full-Stack)
SEO_PERSON_JOB=""

# Temas, tecnologías o habilidades de conocimiento (ej: "PHP, JavaScript, CSS")
SEO_PERSON_KNOWS=""


# ==================== EXTERNAL APIs ====================
# Clave de API para integraciones con Google Gemini AI
GEMINI_API_KEY=""
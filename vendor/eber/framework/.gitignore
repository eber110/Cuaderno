# ===== Dependencias y entorno =====
/vendor/
.env
.env.local

# ===== Archivos generados por scripts =====
# Regenerables con: composer min-script
/App/Public/Min/*
!/App/Public/Min/.gitkeep
/App/Public/Css/font-project.css
/App/Config/preloadFonts.json
/App/Public/Css/jit-compiled.css

# ===== Datos de ejecución =====
/Logs/
/Cache/
/Uploads/
/App/Public/Uploads/
/Database/*
!/Database/.gitkeep
*.log

# ===== Bases de datos y geolocalización (descargables / locales) =====
*.mmdb
*.sqlite
*.sqlite-wal
*.sqlite-shm

# ===== Herramientas / descriptores IDE =====
.scratch/
.vscode/

# ===== Archivos auxiliares =====
*.zip
App.zip